{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "body-sim-report",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--bind",
        "127.0.0.1",
        "--directory",
        "experiments/body-sim/out"
      ],
      "port": 8765
    },
    {
      "name": "psyche-test",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PSYCHE_DATA_DIR=/Users/joy/.psyche/test",
        "PSYCHE_PORT=7450",
        "bun",
        "run",
        "src/main.ts"
      ],
      "port": 7450
    },
    {
      "name": "soma",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "/Users/joy/workspace/Soma",
        "run",
        "dev"
      ],
      "port": 30151
    },
    {
      "name": "soma-test",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd /Users/joy/workspace/Soma && SOMA_HOME=/Users/joy/.soma-test SOMA_CLAUDE_CONFIG_DIR=/Users/joy/.soma/claude PSYCHE_URL=http://127.0.0.1:7450 SOMA_COMPACT_AT=0.01 SOMA_DIST_DIR=.next-test exec npx next dev -H 127.0.0.1 -p 30152"
      ],
      "port": 30152
    }
  ]
}
